# === Newslingo 환경변수 예시 ===
# 이 파일을 복사해서 `.env` 로 만들고 값을 채워주세요.
#   cp .env.example .env

# OpenAI (모델1 메인 / 모델2 가드레일 공통)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Guardian Open Platform - 무료 Developer 키 (비상업적 이용)
# 발급: https://bonobo.capi.gutools.co.uk/register/developer
# (NewsAPI.org 에서 교체됨: NewsAPI의 content 필드는 200자로 강제 절단되어 기사 전문을
#  가져올 수 없었음. Guardian은 show-fields=bodyText 로 기사 본문 전체를 제공)
GUARDIAN_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 뉴스 API 키가 없어도 데모가 돌아가도록 하는 목(mock) 모드
#   true  = 내장된 샘플 기사로 동작 (발표/오프라인용)
#   false = 실제 Guardian Open Platform 호출
NEWSLINGO_USE_MOCK_NEWS=true
