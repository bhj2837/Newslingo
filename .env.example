# === Newslingo 환경변수 예시 ===
# 이 파일을 복사해서 `.env` 로 만들고 값을 채워주세요.
#   cp .env.example .env

# OpenAI (모델1 메인 / 모델2 가드레일 공통)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NewsAPI.org - 무료 티어 (https://newsapi.org 회원가입 후 발급)
NEWS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 뉴스 API 키가 없어도 데모가 돌아가도록 하는 목(mock) 모드
#   true  = 내장된 샘플 기사로 동작 (발표/오프라인용)
#   false = 실제 NewsAPI.org 호출
NEWSLINGO_USE_MOCK_NEWS=true
